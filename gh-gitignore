#!/bin/bash

type fzf >/dev/null 2>&1
if [[ ! $? = 0 ]]; then
  echo -e  "error: fzf command is not found.\n\nPlease install fzf command.\n ex) brew install fzf"
  exit 1
fi

# `gh auth token` resolves the token from the system keyring (macOS Keychain,
# GNOME Keyring, Wincred) as well as from GH_TOKEN/GITHUB_TOKEN, so it keeps
# working now that gh stores credentials in encrypted storage.
if ! gh auth token >/dev/null 2>&1; then
  echo -e "error: no GitHub authentication token found.\n\nPlease run 'gh auth login' to authenticate."
  exit 1
fi

REPO="github/gitignore"
NAME=$(gh api repos/${REPO}/contents --jq .[].name | grep ".gitignore" | fzf)

if [[ ${NAME} = "" ]];then
  echo -e "error: no file selected.\n\nPlease select .gitignore file to download"
  exit 1
fi

DEST=".gitignore"

# By default the selected template overwrites ${DEST}. Set APPEND=1 to append
# to the existing file instead of replacing it.
if [[ ${APPEND} = "1" ]]; then
  # Avoid gluing the template onto a file that does not end with a newline.
  if [[ -s ${DEST} && -n "$(tail -c 1 ${DEST})" ]]; then
    printf '\n' >> "${DEST}"
  fi
  curl -s https://raw.githubusercontent.com/${REPO}/master/${NAME} >> "${DEST}"
  echo "✓ Appended ${NAME} to ${PWD}/${DEST}"
else
  curl -s https://raw.githubusercontent.com/${REPO}/master/${NAME} > "${DEST}"
  echo "✓ Downloaded ${NAME} to ${PWD}/${DEST}"
fi
